{
  "name": "society-os",
  "version": "1.0.0",
  "private": true,
  "description": "Society OS — Complete Community and Society Management Monorepo",
  "scripts": {
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:web": "npm --prefix apps/mobile run web",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:test": "npm --prefix apps/mobile run test -- --runInBand",
    "mobile:test:coverage": "npm --prefix apps/mobile run test:coverage",
    "mobile:verify:resident-routes": "npm --prefix apps/mobile run verify:resident-routes",
    "mobile:verify:import-cycles": "npm --prefix apps/mobile run verify:import-cycles",
    "mobile:verify:ui-structure": "npm --prefix apps/mobile run verify:ui-structure",
    "mobile:verify:localized-ui": "npm --prefix apps/mobile run verify:localized-ui",
    "mobile:verify:types": "npm --prefix apps/mobile run verify:types",
    "mobile:verify:clean-source": "npm --prefix apps/mobile run verify:clean-source",
    "mobile:export": "npm --prefix apps/mobile exec expo export --platform ios"
  }
}
