{
  "name": "society-os-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start",
    "android": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --android",
    "ios": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --ios",
    "web": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --web",
    "generate:localization": "node scripts/generate-localization-resources.mjs",
    "migrate:ui-literals": "node scripts/migrate-visible-ui-literals.mjs",
    "migrate:native-alerts": "node scripts/migrate-native-alerts.mjs",
    "clean:comments": "node scripts/remove-source-comments.mjs",
    "harden:indexed-access": "node scripts/harden-indexed-access.mjs",
    "harden:exact-optional": "node scripts/harden-exact-optional-properties.mjs",
    "harden:undefined-types": "node scripts/replace-explicit-undefined-types.mjs",
    "extract:styles": "node scripts/extract-component-styles.mjs",
    "extract:inline-styles": "node scripts/extract-static-inline-styles.mjs",
    "extract:dynamic-styles": "node scripts/extract-dynamic-inline-styles.mjs",
    "verify:types": "node scripts/verify-type-safety.mjs",
    "verify:clean-source": "node scripts/verify-source-cleanliness.mjs",
    "verify:localized-ui": "node scripts/verify-localized-ui.mjs",
    "verify:import-cycles": "node scripts/verify-import-cycles.mjs",
    "verify:ui-structure": "node scripts/verify-ui-structure.mjs",
    "audit:unreachable-source": "node scripts/audit-unreachable-source.mjs",
    "verify:resident-routes": "jest src/features/residentCapabilities/tests/residentRouteReleaseCoverage.test.ts --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "quality": "npm run typecheck && npm run lint && npm run verify:types && npm run verify:clean-source && npm run verify:localized-ui && npm run verify:import-cycles && npm run verify:ui-structure && npm run test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
